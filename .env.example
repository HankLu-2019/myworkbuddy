# Copy to .env and fill in. Generate an encryption key with:
#   docker compose run --rm api mwb generate-key
# MWB_SECRET_KEYS takes a comma-separated list (newest first) for key rotation; MWB_SECRET_KEY (one key) also works.
# Back this value up separately: without it, stored tokens can't be decrypted.
POSTGRES_PASSWORD=change-me
MWB_SECRET_KEY=
# Keep the key that protects stored tokens in HashiCorp Vault instead (Transit). Setup: deploy/vault/init.sh,
# which prints the values for these. With Vault, MWB_SECRET_KEY only reads values written before the switch.
MWB_SECRETS_BACKEND=fernet
MWB_VAULT_ADDR=
MWB_VAULT_ROLE_ID=
MWB_VAULT_SECRET_ID=
# Public address and TLS (design 01 §H3). Production refuses to start without HTTPS.
# For local development `docker compose up` uses the dev override instead (http://localhost:8080).
MWB_HOSTNAME=https://mwb.example.com
MWB_TLS_MODE=files               # files: deploy/tls/cert.pem + key.pem | internal: Caddy's own CA
MWB_COOKIE_SECURE=true

# Single sign-on with OpenID Connect (design 08 §F11). Empty issuer: off. Register the redirect URI
# <MWB_HOSTNAME>/api/auth/oidc/callback with the provider.
MWB_OIDC_ISSUER=
MWB_OIDC_CLIENT_ID=
MWB_OIDC_CLIENT_SECRET=
MWB_OIDC_SCOPES=openid email profile
MWB_OIDC_NAME=SSO
MWB_OIDC_AUTO_CREATE=false
# all | admins (members sign in with SSO only; admins keep the password as a fallback)
MWB_LOCAL_LOGIN=all

# Admin-registered MCP servers, read tools only (design 08 §F12)
MWB_MCP_CALL_TIMEOUT_S=30
MWB_MCP_MAX_OUTPUT_CHARS=20000
MWB_LOG_LEVEL=INFO
MWB_DEFAULT_TIMEZONE=Europe/Stockholm

# LLM gateway (LiteLLM). Only the api/worker key manager uses the master key; every LLM call uses the user's own
# virtual key, created automatically with the user's monthly budget.
LITELLM_MASTER_KEY=sk-mwb-change-me
# Password for the gateway's own database (virtual keys, budgets, spend). Required; `mwb db-bootstrap` creates it.
LITELLM_DB_PASSWORD=
# Monthly AI budget per user in USD (admins can change it per user).
MWB_DEFAULT_USER_BUDGET_USD=50

# AWS Bedrock credentials (or mount an instance role).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Model IDs as enabled in your Bedrock account (LiteLLM "bedrock/" prefix).
MWB_CHAT_MODEL_ID=bedrock/anthropic.claude-opus-5-5
MWB_FAST_MODEL_ID=bedrock/anthropic.claude-haiku-5-5
MWB_EMBED_MODEL_ID=bedrock/amazon.titan-embed-text-v2:0
# Planner (Phase 3); leave empty to use the chat model.
MWB_PLANNER_MODEL_ID=
# Coding jobs (Phase 4): a Claude model, used by Claude Code through the gateway; empty: the chat model.
MWB_CODER_MODEL_ID=

# Optional OpenAI-compatible endpoint (see gateway/litellm.yaml)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Allow http:// repository URLs (only for local test servers)
MWB_ALLOW_HTTP_REPOS=false
# Allow http:// integration URLs (dev and tests only; refused when MWB_ENV=prod)
MWB_ALLOW_HTTP_INTEGRATIONS=false
# Self-hosted servers without TLS that may be reached over plain http even in production (comma-separated,
# wildcards allowed), e.g. gitlab.local,*.corp.internal. Self-hosted https needs nothing here.
MWB_HTTP_INTERNAL_HOSTS=

# Upgrading from Phase 1 (design 02 §1): set these once before running migration 0006 to move users' saved
# GitLab/Gerrit/Jira tokens into integrations. Without them, the tokens move when an admin adds the
# integration in Admin → Integrations.
MWB_GITLAB_URL=
MWB_GERRIT_URL=
MWB_JIRA_URL=

# Email notifications (design 02 §5). Without MWB_SMTP_HOST, emails stay queued and Admin → System says so.
# A username needs STARTTLS in production.
MWB_SMTP_HOST=
MWB_SMTP_PORT=587
MWB_SMTP_USER=
MWB_SMTP_PASSWORD=
MWB_SMTP_FROM=MyWorkBuddy <mwb@example.com>
MWB_SMTP_STARTTLS=true
MWB_MAX_EMAILS_PER_DAY=30

# Slack and Teams notifications (design 08 §F8)
MWB_NOTIFY_WEBHOOK_HOSTS=hooks.slack.com,*.webhook.office.com,*.logic.azure.com
MWB_MAX_MESSAGES_PER_DAY=50

# Schedules (design 02 §4, §9)
MWB_SCHEDULE_MIN_INTERVAL_MIN=15
MWB_SCHEDULE_MIN_INTERVAL_ADMIN_MIN=5
MWB_MAX_SCHEDULES_PER_USER=20
MWB_RUNS_RETENTION_DAYS=180
# Username whose AI budget the nightly agent evals use; empty: no nightly evals (run them with `mwb eval-agents`).
MWB_AGENT_EVALS_USER=

# Plans (design 03): hosts a plan may ask the Phase 4 sandbox to reach (comma-separated), auto-drafts per day.
MWB_SANDBOX_OPTIONAL_HOSTS=
MWB_AUTOPLAN_PER_DAY=5

# Coding jobs (design 04). gVisor must be installed for runsc (docs/design/06-operations.md §1); runc only where it
# can't be, and the System page then warns. Allowlists are space- or comma-separated host names.
MWB_SANDBOX_RUNTIME=runsc
# Verification with containers (design 08 §F10): per repository, by an admin; needs Sysbox on the host.
MWB_SERVICES_IMAGE=mwb-sandbox-dind:latest
MWB_PROXY_REGISTRY_HOSTS=
# The runner's bearer token (api, worker and runner share it): python3 -c "import secrets;print(secrets.token_urlsafe(32))"
MWB_RUNNER_TOKEN=
# Jobs at once (worker-jobs slots), the AI budget of one job's key, and the agent's turn cap.
MWB_MAX_CONCURRENT_JOBS=2
MWB_JOB_BUDGET_USD=10
MWB_JOB_MAX_TURNS=60
# Jobs left in review are discarded after this many days; a sandbox's workspace may grow to this size.
MWB_JOB_REVIEW_DAYS=7
# Questions the agent may ask per job (it waits for your answer).
MWB_JOB_MAX_QUESTIONS=3
MWB_JOB_DISK_GB=10
MWB_PROXY_AGENT_HOSTS=llm-gateway pypi.org files.pythonhosted.org registry.npmjs.org proxy.golang.org sum.golang.org
MWB_PROXY_VERIFY_HOSTS=pypi.org files.pythonhosted.org registry.npmjs.org proxy.golang.org sum.golang.org

# Backups (docs/design/06-operations.md §5). Keep RESTIC_PASSWORD with this file: snapshots are unreadable without it.
MWB_BACKUP_REPO=
RESTIC_PASSWORD=
# Only for an S3 repository (separate from the Bedrock credentials above).
MWB_BACKUP_AWS_ACCESS_KEY_ID=
MWB_BACKUP_AWS_SECRET_ACCESS_KEY=

# Copy to .env and fill in. Generate an encryption key with:
#   docker compose run --rm api mwb generate-key
# MWB_SECRET_KEYS takes a comma-separated list (newest first) for key rotation; MWB_SECRET_KEY (one key) also works.
# Back this value up separately: without it, stored tokens can't be decrypted.
POSTGRES_PASSWORD=change-me
MWB_SECRET_KEY=
# Public address and TLS (design 01 §H3). Production refuses to start without HTTPS.
# For local development `docker compose up` uses the dev override instead (http://localhost:8080).
MWB_HOSTNAME=https://mwb.example.com
MWB_TLS_MODE=files               # files: deploy/tls/cert.pem + key.pem | internal: Caddy's own CA
MWB_COOKIE_SECURE=true
MWB_LOG_LEVEL=INFO
MWB_DEFAULT_TIMEZONE=Europe/Stockholm

# LLM gateway (LiteLLM). The api/worker authenticate to it with this key.
LITELLM_MASTER_KEY=sk-mwb-change-me
# Password for the gateway's own database (created by `mwb db-bootstrap`; used from task H12). Leave empty until then.
LITELLM_DB_PASSWORD=

# AWS Bedrock credentials (or mount an instance role).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Model IDs as enabled in your Bedrock account (LiteLLM "bedrock/" prefix).
MWB_CHAT_MODEL_ID=bedrock/anthropic.claude-opus-5-5
MWB_FAST_MODEL_ID=bedrock/anthropic.claude-haiku-5-5
MWB_EMBED_MODEL_ID=bedrock/amazon.titan-embed-text-v2:0

# Optional OpenAI-compatible endpoint (see gateway/litellm.yaml)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Allow http:// repository URLs (only for local test servers)
MWB_ALLOW_HTTP_REPOS=false
